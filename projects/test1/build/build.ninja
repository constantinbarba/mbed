# Object build statements for STATIC_LIBRARY target mbed-randlib


#############################################
# Order-only phony target for mbed-randlib

build cmake_object_order_depends_target_mbed-randlib: phony || cmake_object_order_depends_target_mbed-mbedtls

build build/mbed-os-build/platform/randlib/CMakeFiles/mbed-randlib.dir/source/randLIB.c.obj: C_COMPILER__mbed-randlib_unscanned_Develop f$:/CSHome/Mbed/tools_mbed/mbed-os/platform/randlib/source/randLIB.c || cmake_object_order_depends_target_mbed-randlib
