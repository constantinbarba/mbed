  OBJECT_DIR = build\mbed-os-build\connectivity\nanostack\CMakeFiles\mbed-nanostack.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_COMPILE_PDB = build\mbed-os-build\connectivity\nanostack\CMakeFiles\mbed-nanostack.dir\mbed-nanostack.pdb
